# Canonical production origin. No trailing slash. Never use localhost in production.
SITE_URL=https://www.motoguia.ar

# development | preview | production
DEPLOYMENT_STAGE=development

# Indexing requires production stage AND a real canonical origin.
PUBLIC_INDEXING_ENABLED=false

PUBLIC_SITE_NAME=MotoGuía AR

# Leave empty until a real inbox exists. Do not invent an address.
PUBLIC_CONTACT_EMAIL=

# Ads stay off until a real AdSense account, slot IDs and consent setup exist.
PUBLIC_ENABLE_ADS=false
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_ARTICLE=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
ADS_TXT_LINE=

# Analytics stay off until a real GA4 ID and consent setup exist.
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_CONSENT_PROVIDER=
