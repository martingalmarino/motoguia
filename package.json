{
  "name": "motoguia-ar",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Portal estático argentino para elegir, comparar y calcular el costo de tener una moto.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && npm run validate && npm test && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/validate-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "launch-check": "node scripts/launch-check.mjs",
    "og": "node scripts/build-og.mjs",
    "prices": "node scripts/update-prices.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/archivo": "^5.3.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.1",
    "playwright": "^1.64.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.9.1"
  }
}
