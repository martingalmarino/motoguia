---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/editorial/PageHeader.astro';
import { analytics, ads, paths, site } from '../config/site';

const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.privacy, label: 'Política de privacidad' },
];
---

<BaseLayout title="Política de privacidad" description="Qué datos trata MotoGuía AR y qué servicios de medición o anuncios pueden estar activos." path={paths.privacy}>
  <div class="wrap">
    <PageHeader crumbs={crumbs} title="Política de privacidad" />
    <div class="prose page-body">
      <p>No pedimos cuentas ni datos personales. No hay formulario de registro.</p>
      <p>El comparador guarda en tu navegador los modelos que elegiste. Esa información no se envía a nuestros servidores.</p>
      <p>Anuncios: {ads.enabled ? 'hay anuncios de Google configurados.' : 'no hay anuncios activos.'}</p>
      <p>Medición: {analytics.enabled ? 'hay medición de audiencia configurada.' : 'no hay medición activa.'}</p>
      {
        (ads.enabled || analytics.enabled) && (
          <p>
            Si se activan anuncios o medición en una jurisdicción que exige un gestor de consentimiento certificado, ese mecanismo se publica junto con el servicio.
          </p>
        )
      }
      <p>
        Contacto del responsable: {site.contactEmail ? <a href={paths.contact}>{site.contactEmail}</a> : <a href={paths.contact}>página de contacto</a>}.
      </p>
    </div>
  </div>
</BaseLayout>
