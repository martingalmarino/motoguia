---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/editorial/PageHeader.astro';
import { ads, analytics, paths } from '../config/site';

const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.cookies, label: 'Política de cookies' },
];
---

<BaseLayout title="Política de cookies" description="Qué cookies usa MotoGuía AR según anuncios y medición activos." path={paths.cookies}>
  <div class="wrap">
    <PageHeader crumbs={crumbs} title="Política de cookies" />
    <div class="prose page-body">
      <p>
        {
          ads.enabled || analytics.enabled
            ? `Hay servicios de ${[ads.enabled && 'anuncios', analytics.enabled && 'medición'].filter(Boolean).join(' y ')} que pueden usar cookies.`
            : 'Hoy no usamos cookies de publicidad ni de medición.'
        }
      </p>
      <p>El comparador usa el almacenamiento local de tu navegador, no cookies de seguimiento.</p>
    </div>
  </div>
</BaseLayout>
