---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/editorial/PageHeader.astro';
import { paths, site } from '../config/site';

const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.about, label: 'Sobre nosotros' },
];
---

<BaseLayout title="Sobre nosotros" description="Qué es MotoGuía AR y cómo trabaja la redacción." path={paths.about}>
  <div class="wrap">
    <PageHeader
      crumbs={crumbs}
      eyebrow="Sobre MotoGuía"
      title={`Sobre ${site.name}`}
      lede="Una guía para elegir y comparar motos en Argentina."
    />
    <div class="prose page-body">
      <p>
        {site.name} reúne fichas técnicas de los modelos que se venden en el país, el ranking de patentamientos y calculadoras para estimar cuánto cuesta usar una moto. No somos concesionaria, sitio de clasificados ni foro.
      </p>
      <p>
        La redacción firma como {site.editorLabel}. Cuando una marca no publica la potencia, el precio o el origen de un modelo, lo indicamos como “No informado”. No publicamos pruebas de manejo ni puntajes propios.
      </p>
      <p>
        Los patentamientos de ACARA/SIOMAA miden motos registradas, no ventas de concesionario. Cómo usamos cada fuente está explicado en la página de <a href={paths.methodology}>metodología</a>.
      </p>
    </div>
  </div>
</BaseLayout>
