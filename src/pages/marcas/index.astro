---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/editorial/PageHeader.astro';
import { paths } from '../../config/site';
import { getAllBrands, getPublishedMotorcycles } from '../../lib/content/catalog';
import { formatInteger } from '../../lib/format';

const motos = await getPublishedMotorcycles();
const brands = getAllBrands()
  .map((brand) => ({ brand, count: motos.filter((moto) => moto.data.brandId === brand.id).length }))
  .filter((item) => item.count > 0);
---

<BaseLayout title="Marcas de motos en Argentina" description="Marcas con ficha publicada en MotoGuía AR. El origen de fábrica se declara solo con fuente." path={paths.brands}>
  <article class="wrap editorial-article">
    <PageHeader
      eyebrow="Directorio"
      title="Marcas"
      lede="Solo aparecen marcas con al menos una ficha publicada. El origen de fábrica se declara únicamente con fuente."
    />
    <ul class="guide-list">
      {
        brands.map(({ brand, count }) => (
          <li>
            <a class="card" href={`${paths.brands}${brand.slug}/`}>
              {brand.name}
              <span>{formatInteger(count)} ficha{count === 1 ? '' : 's'}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</BaseLayout>
