---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandTile from '../../components/catalog/BrandTile.astro';
import PageHeader from '../../components/editorial/PageHeader.astro';
import { paths } from '../../config/site';
import { getAllBrands, getPublishedMotorcycles } from '../../lib/content/catalog';

const motos = await getPublishedMotorcycles();
const brands = getAllBrands()
  .map((brand) => ({ brand, count: motos.filter((moto) => moto.data.brandId === brand.id).length }))
  .filter((item) => item.count > 0);
const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.brands, label: 'Marcas' },
];
---

<BaseLayout
  title="Marcas de motos en Argentina"
  description="Explorá las marcas de motos con modelos en MotoGuía: Honda, Motomel, Corven, Gilera, Zanella y más, con fichas técnicas y precios de referencia."
  path={paths.brands}
>
  <div class="wrap">
    <PageHeader
      crumbs={crumbs}
      title="Marcas de motos"
      lede="Elegí una marca para ver sus modelos, compararlos y conocer sus características principales."
    />
    <div class="brand-directory">
      {brands.map(({ brand, count }) => <BrandTile brand={brand} count={count} />)}
    </div>
  </div>
</BaseLayout>
