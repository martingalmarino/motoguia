---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandTile from '../components/catalog/BrandTile.astro';
import BlogPostList from '../components/editorial/BlogPostList.astro';
import MotorcycleCard from '../components/catalog/MotorcycleCard.astro';
import SearchForm from '../components/search/SearchForm.astro';
import Icon from '../components/ui/Icon.astro';
import { paths, rankingYearPath, site } from '../config/site';
import {
  getAllBrands,
  getPublishedBlogPosts,
  getPublishedMotorcycles,
  getLatestSummaryRanking,
  motorcycleUrl,
} from '../lib/content/catalog';
import { displayName, priceReference, reportModelLabel, stageImage } from '../lib/content/present';
import { periodShortLabel } from '../lib/content/ranking-period';
import { formatDate, formatInteger } from '../lib/format';
import { organizationLd, websiteLd } from '../lib/seo/jsonld';

const motos = await getPublishedMotorcycles();
const byId = new Map(motos.map((entry) => [entry.data.id, entry]));
const ranking = await getLatestSummaryRanking();
const latestPosts = (await getPublishedBlogPosts()).slice(0, 3);

const pick = (ids: string[]) =>
  ids.map((id) => byId.get(id)).filter((entry): entry is (typeof motos)[number] => Boolean(entry));

const hero = byId.get('honda-wave-110s') ?? motos[0];
const heroImage = stageImage(hero);
const heroRank = ranking?.data.rows.find((row) => row.modelIds.includes(hero.data.id));
const heroPriceRef = priceReference(hero);
const heroPrice = heroPriceRef
  ? `${heroPriceRef.prefix ? `${heroPriceRef.prefix} ` : ''}${heroPriceRef.amount} · ${heroPriceRef.typeLabel} al ${heroPriceRef.date}`
  : 'Precio no disponible';

const brandTiles = getAllBrands()
  .map((brand) => ({ brand, count: motos.filter((moto) => moto.data.brandId === brand.id).length }))
  .filter((item) => item.count > 0)
  .sort((a, b) => b.count - a.count || a.brand.name.localeCompare(b.brand.name, 'es'))
  .slice(0, 8);

const featured = pick([
  'honda-wave-110s',
  'gilera-smash',
  'motomel-s2-150',
  'corven-triax-150',
  'honda-navi',
  'siam-n4',
  'honda-glh-150',
  'honda-xr150l',
]);

const cityCount = motos.filter((moto) => ['cub', 'scooter'].includes(moto.data.category)).length;
const electric = motos.filter((moto) => moto.data.engineType === 'electric');
const chinese = motos.filter((moto) => moto.data.chineseHub);
const typeCards = [
  {
    title: 'Motos para la ciudad',
    text: 'Cubs y scooters para moverte todos los días por la ciudad.',
    href: `${paths.catalog}#categoria=cub,scooter`,
    count: cityCount,
    tone: 'city',
  },
  {
    title: 'Motos eléctricas',
    text: 'Modelos a batería con la potencia y la autonomía que declara cada marca.',
    href: paths.electric,
    count: electric.length,
    tone: 'electric',
  },
  {
    title: 'Motos chinas',
    text: 'Las marcas de mayor volumen del mercado, con su origen explicado cuando hay fuente.',
    href: paths.chinese,
    count: chinese.length,
    tone: 'chinese',
  },
].filter((card) => card.count > 0);

const topFive = (ranking?.data.rows ?? []).slice(0, 5).map((row) => {
  const entry = row.modelIds.map((id) => byId.get(id)).find(Boolean);
  return {
    rank: row.rank,
    units: row.units,
    entry,
    name: entry ? displayName(entry) : reportModelLabel(row.reportModelName),
  };
});

---

<BaseLayout
  title={site.tagline}
  description="Explorá motos en Argentina: modelos por marca, fichas técnicas, precios de referencia, ranking de patentamientos, comparador y calculadoras de costo."
  path={paths.home}
  jsonLd={[organizationLd(), websiteLd()]}
>
  <section class="home-hero">
    <div class="wrap home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">Motos en Argentina</p>
        <h1>Encontrá la moto que va con vos.</h1>
        <p class="home-hero__support">Explorá modelos, compará características y calculá cuánto cuesta tener tu próxima moto.</p>
        <SearchForm
          id="busqueda-inicio"
          label="¿Qué moto estás buscando?"
          hideLabel
          placeholder="¿Qué moto estás buscando?"
        />
        <div class="home-hero__links">
          <a class="home-hero__cta" href={paths.catalog}>Ver todas las motos</a>
          <a class="home-hero__cta" href={paths.comparator}>Comparar modelos</a>
        </div>
      </div>
      <a class="home-hero__feat" href={motorcycleUrl(hero)}>
        {
          heroRank && ranking && (
            <span class="home-hero__badge">N.º {heroRank.rank} en patentamientos {periodShortLabel(ranking.data)}</span>
          )
        }
        <img
          src={heroImage.src}
          srcset={heroImage.srcset ?? undefined}
          sizes="(min-width: 1024px) 560px, 340px"
          alt={heroImage.alt}
          width="1200"
          height="900"
          fetchpriority="high"
        />
        <strong>{displayName(hero)}</strong>
        <span class="home-hero__price">{heroPrice}</span>
      </a>
    </div>
  </section>

  <section class="home-block" aria-labelledby="marcas-titulo">
    <div class="wrap">
      <div class="home-head">
        <h2 id="marcas-titulo">Elegí tu marca</h2>
        <a class="home-more" href={paths.brands}>Ver todas las marcas</a>
        <p>Explorá los modelos y encontrá sus características principales.</p>
      </div>
      <div class="brand-tiles home-brands">
        {brandTiles.map(({ brand, count }) => <BrandTile brand={brand} count={count} />)}
      </div>
    </div>
  </section>

  <section class="home-block home-block--alt" aria-labelledby="modelos-titulo">
    <div class="wrap">
      <div class="home-head">
        <h2 id="modelos-titulo">Explorá modelos</h2>
        <a class="home-more" href={paths.catalog}>Ver catálogo completo</a>
        <p>Una selección de cubs, street, trail, scooters y eléctricas del catálogo.</p>
      </div>
      <div class="home-models moto-grid--shelf">
        {featured.map((entry) => <MotorcycleCard entry={entry} shelf />)}
      </div>
    </div>
  </section>

  <section class="home-block" aria-labelledby="tipos-titulo">
    <div class="wrap">
      <div class="home-head">
        <h2 id="tipos-titulo">Buscá por tipo de moto</h2>
      </div>
      <div class="type-cards">
        {
          typeCards.map((card) => (
            <a class:list={['type-card', `type-card--${card.tone}`]} href={card.href} data-n={card.count}>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <span class="type-card__cta">
                Ver {formatInteger(card.count)} {card.count === 1 ? 'modelo' : 'modelos'}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    ranking && (
      <section class="home-block home-block--alt" aria-labelledby="ranking-titulo">
        <div class="wrap">
          <div class="home-head">
            <h2 id="ranking-titulo">Las motos más vendidas de Argentina</h2>
            <a class="home-more" href={rankingYearPath(ranking.data.year)}>Ver ranking completo</a>
            <p>
              Patentamientos acumulados del {formatDate(ranking.data.periodStart)} al {formatDate(ranking.data.periodEnd)}, según ACARA/SIOMAA.
            </p>
          </div>
          <ol class="rank-list">
            {topFive.map((row) => (
              <li class="rank-item">
                <span class="rank-item__pos" aria-label={`Puesto ${row.rank}`}>{row.rank}</span>
                <span class="rank-item__copy">
                  <span class="rank-item__name">
                    {row.entry ? <a href={motorcycleUrl(row.entry)}>{row.name}</a> : row.name}
                    {!row.entry && <span class="rank-item__note">Sin ficha en MotoGuía</span>}
                  </span>
                  <small class="rank-item__units">{formatInteger(row.units)} patentamientos</small>
                </span>
              </li>
            ))}
          </ol>
          <p class="ranking-footer">
            Cuenta motos patentadas, no ventas de concesionario. <a href={paths.methodology}>Cómo armamos el ranking</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="home-block" aria-labelledby="herramientas-titulo">
    <div class="wrap">
      <div class="home-head">
        <h2 id="herramientas-titulo">Herramientas para decidir</h2>
        <a class="home-more" href={paths.tools}>Ver herramientas</a>
      </div>
      <div class="tool-tiles home-tools">
        <a class="tool-tile" href={paths.patente}>
          <span class="tool-tile__icon"><Icon name="receipt" size={22} /></span>
          <h3>Calculá la patente de tu moto</h3>
          <p>Estimá el impuesto anual según tu provincia y el modelo.</p>
          <span class="tool-tile__cta">Calcular patente</span>
        </a>
        <a class="tool-tile" href={paths.fuel}>
          <span class="tool-tile__icon"><Icon name="fuel" size={22} /></span>
          <h3>Calculá tu gasto en combustible</h3>
          <p>Estimá cuánto gastás según tus kilómetros y el precio por litro.</p>
          <span class="tool-tile__cta">Calcular combustible</span>
        </a>
        <a class="tool-tile" href={paths.monthlyCost}>
          <span class="tool-tile__icon"><Icon name="wallet" size={22} /></span>
          <h3>Estimá el costo mensual</h3>
          <p>Sumá combustible, seguro, patente y mantenimiento.</p>
          <span class="tool-tile__cta">Calcular costo mensual</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-block home-block--alt" aria-labelledby={latestPosts.length > 0 ? 'blog-titulo' : undefined}>
    <div class="wrap">
      {
        latestPosts.length > 0 && (
          <>
            <div class="home-head">
              <h2 id="blog-titulo">Últimos artículos del blog</h2>
              <a class="home-more" href={paths.blog}>Ver el blog</a>
            </div>
            <BlogPostList posts={latestPosts} />
          </>
        )
      }
      <p class="home-note">
        MotoGuía reúne fichas técnicas, precios de referencia con fecha y datos de patentamientos de fuentes públicas para que compares
        motos en Argentina con información clara. <a href={paths.methodology}>Cómo trabajamos</a>.
      </p>
    </div>
  </section>
</BaseLayout>
