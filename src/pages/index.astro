---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandTile from '../components/catalog/BrandTile.astro';
import MotorcycleCard from '../components/catalog/MotorcycleCard.astro';
import SearchForm from '../components/search/SearchForm.astro';
import Icon from '../components/ui/Icon.astro';
import { paths, rankingYearPath, site } from '../config/site';
import {
  getAllBrands,
  getPublishedAccessoryGuides,
  getPublishedGuides,
  getPublishedMotorcycles,
  getLatestSummaryRanking,
  motorcycleUrl,
} from '../lib/content/catalog';
import { displayName, reportModelLabel, stageImage } from '../lib/content/present';
import { periodShortLabel } from '../lib/content/ranking-period';
import { formatDate, formatInteger } from '../lib/format';
import { organizationLd, websiteLd } from '../lib/seo/jsonld';

const motos = await getPublishedMotorcycles();
const byId = new Map(motos.map((entry) => [entry.data.id, entry]));
const ranking = await getLatestSummaryRanking();
const guides = await getPublishedGuides();
const accessories = await getPublishedAccessoryGuides();

const pick = (ids: string[]) =>
  ids.map((id) => byId.get(id)).filter((entry): entry is (typeof motos)[number] => Boolean(entry));

const hero = byId.get('honda-wave-110s') ?? motos[0];
const heroImage = stageImage(hero);
const heroRank = ranking?.data.rows.find((row) => row.modelIds.includes(hero.data.id));

const brandTiles = getAllBrands()
  .map((brand) => ({ brand, count: motos.filter((moto) => moto.data.brandId === brand.id).length }))
  .filter((item) => item.count > 0)
  .sort((a, b) => b.count - a.count || a.brand.name.localeCompare(b.brand.name, 'es'))
  .slice(0, 8);

const featured = pick(['honda-wave-110s', 'gilera-smash', 'motomel-s2-150', 'corven-triax-150', 'honda-navi', 'siam-n4']);

const cityCount = motos.filter((moto) => ['cub', 'scooter'].includes(moto.data.category)).length;
const electric = motos.filter((moto) => moto.data.engineType === 'electric');
const chinese = motos.filter((moto) => moto.data.chineseHub);
const typeCards = [
  {
    title: 'Motos para la ciudad',
    text: 'Cubs y scooters para moverte todos los días por la ciudad.',
    href: `${paths.catalog}#categoria=cub,scooter`,
    count: cityCount,
    image: byId.get('honda-navi'),
  },
  {
    title: 'Motos eléctricas',
    text: 'Modelos a batería con la potencia y la autonomía que declara cada marca.',
    href: paths.electric,
    count: electric.length,
    image: byId.get('siam-n4'),
  },
  {
    title: 'Motos chinas',
    text: 'Las marcas de mayor volumen del mercado, con su origen explicado cuando hay fuente.',
    href: paths.chinese,
    count: chinese.length,
    image: byId.get('gilera-smash'),
  },
].filter((card) => card.count > 0);

const topFive = (ranking?.data.rows ?? []).slice(0, 5).map((row) => {
  const entry = row.modelIds.map((id) => byId.get(id)).find(Boolean);
  return {
    rank: row.rank,
    units: row.units,
    entry,
    name: entry ? displayName(entry) : reportModelLabel(row.reportModelName),
    image: entry ? stageImage(entry) : null,
  };
});

const guideCards = [
  guides.find((guide) => guide.id === 'primera-moto-argentina'),
  guides.find((guide) => guide.id === 'comprar-moto-usada'),
].filter((guide): guide is (typeof guides)[number] => Boolean(guide));
const helmet = accessories.find((item) => item.id === 'como-elegir-casco-moto') ?? accessories[0];
---

<BaseLayout
  title={site.tagline}
  description="Explorá motos en Argentina: modelos por marca, fichas técnicas, precios de referencia, ranking de patentamientos, comparador y calculadoras de costo."
  path={paths.home}
  jsonLd={[organizationLd(), websiteLd()]}
>
  <section class="home-hero">
    <div class="wrap home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">Motos en Argentina</p>
        <h1>Encontrá la moto que va con vos.</h1>
        <p class="home-hero__support">Explorá modelos, compará características y calculá cuánto cuesta tener tu próxima moto.</p>
        <SearchForm id="busqueda-inicio" />
        <div class="home-hero__links">
          <a href={paths.catalog}>Ver todas las motos <Icon name="arrow" size={18} /></a>
          <a href={paths.comparator}>Comparar modelos <Icon name="arrow" size={18} /></a>
        </div>
      </div>
      <figure class="home-hero__visual">
        <div class="home-hero__stage">
          <img
            src={heroImage.src}
            srcset={heroImage.srcset ?? undefined}
            sizes="(min-width: 1024px) 640px, 100vw"
            alt={heroImage.alt}
            width="1200"
            height="900"
            fetchpriority="high"
          />
        </div>
        <a class="home-hero__caption" href={motorcycleUrl(hero)}>
          {displayName(hero)}
          {heroRank && ranking && <span>· N.º {heroRank.rank} en patentamientos {periodShortLabel(ranking.data)}</span>}
        </a>
      </figure>
    </div>
  </section>

  <div class="wrap">
    <section class="section" aria-labelledby="marcas-titulo">
      <div class="section-heading">
        <div>
          <h2 id="marcas-titulo">Elegí tu marca</h2>
          <p>Explorá los modelos y encontrá sus características principales.</p>
        </div>
        <a class="link-arrow" href={paths.brands}>Ver todas las marcas <Icon name="arrow" size={18} /></a>
      </div>
      <div class="brand-tiles">
        {brandTiles.map(({ brand, count }) => <BrandTile brand={brand} count={count} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="modelos-titulo">
      <div class="section-heading">
        <div>
          <h2 id="modelos-titulo">Explorá modelos</h2>
          <p>Una selección de cubs, street, trail, scooters y eléctricas del catálogo.</p>
        </div>
        <a class="link-arrow" href={paths.catalog}>Ver catálogo completo <Icon name="arrow" size={18} /></a>
      </div>
      <div class="card-grid card-grid--3">
        {featured.map((entry) => <MotorcycleCard entry={entry} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="tipos-titulo">
      <div class="section-heading">
        <div>
          <h2 id="tipos-titulo">Buscá por tipo de moto</h2>
        </div>
      </div>
      <div class="type-cards">
        {
          typeCards.map((card) => {
            const img = card.image ? stageImage(card.image) : null;
            return (
              <a class="type-card" href={card.href}>
                <div class="type-card__media">
                  {img && <img src={img.src} alt="" width="600" height="450" loading="lazy" decoding="async" />}
                </div>
                <div class="type-card__body">
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                  <span class="type-card__cta">
                    Ver {formatInteger(card.count)} {card.count === 1 ? 'modelo' : 'modelos'} <Icon name="arrow" size={18} />
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

    {
      ranking && (
        <section class="section" aria-labelledby="ranking-titulo">
          <div class="section-heading">
            <div>
              <h2 id="ranking-titulo">Las motos más vendidas de Argentina</h2>
              <p>
                Patentamientos acumulados del {formatDate(ranking.data.periodStart)} al {formatDate(ranking.data.periodEnd)}, según ACARA/SIOMAA.
              </p>
            </div>
            <a class="link-arrow" href={rankingYearPath(ranking.data.year)}>Ver ranking completo <Icon name="arrow" size={18} /></a>
          </div>
          <ol class="rank-list">
            {topFive.map((row) => (
              <li class="rank-item">
                <span class="rank-item__pos" aria-label={`Puesto ${row.rank}`}>{row.rank}</span>
                {row.image ? (
                  <span class="rank-item__img">
                    <img src={row.image.src} alt="" width="64" height="48" loading="lazy" decoding="async" />
                  </span>
                ) : (
                  <span class="rank-item__img rank-item__img--empty" aria-hidden="true" />
                )}
                <span class="rank-item__name">
                  {row.entry ? <a href={motorcycleUrl(row.entry)}>{row.name}</a> : row.name}
                  {!row.entry && <span class="rank-item__note">Sin ficha en MotoGuía</span>}
                </span>
                <span class="rank-item__units">
                  {formatInteger(row.units)} <span>patentamientos</span>
                </span>
              </li>
            ))}
          </ol>
          <p class="ranking-footer muted">
            <span>Cuenta motos patentadas, no ventas de concesionario.</span>
            <a href={paths.methodology}>Cómo armamos el ranking</a>
          </p>
        </section>
      )
    }
  </div>

  <section class="tint-band" aria-labelledby="herramientas-titulo">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <h2 id="herramientas-titulo">Herramientas para decidir</h2>
        </div>
        <a class="link-arrow" href={paths.tools}>Ver herramientas <Icon name="arrow" size={18} /></a>
      </div>
      <div class="tool-tiles">
        <a class="tool-tile" href={paths.comparator}>
          <span class="tool-tile__icon"><Icon name="compare" size={24} /></span>
          <h3>Compará hasta 3 motos</h3>
          <p>Revisá sus características lado a lado.</p>
          <span class="tool-tile__cta">Ir al comparador <Icon name="arrow" size={18} /></span>
        </a>
        <a class="tool-tile" href={paths.fuel}>
          <span class="tool-tile__icon"><Icon name="fuel" size={24} /></span>
          <h3>Calculá tu gasto en combustible</h3>
          <p>Estimá cuánto gastás según tus kilómetros y el precio por litro.</p>
          <span class="tool-tile__cta">Calcular combustible <Icon name="arrow" size={18} /></span>
        </a>
        <a class="tool-tile" href={paths.monthlyCost}>
          <span class="tool-tile__icon"><Icon name="wallet" size={24} /></span>
          <h3>Estimá el costo mensual</h3>
          <p>Sumá combustible, seguro, patente y mantenimiento.</p>
          <span class="tool-tile__cta">Calcular costo mensual <Icon name="arrow" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="section" aria-labelledby="guias-titulo">
      <div class="section-heading">
        <div>
          <h2 id="guias-titulo">Guías para elegir tu moto</h2>
        </div>
        <a class="link-arrow" href={paths.guides}>Ver todas las guías <Icon name="arrow" size={18} /></a>
      </div>
      <div class="editorial-cards">
        {
          guideCards.map((guide) => (
            <a class="editorial-card" href={`${paths.guides}${guide.id}/`}>
              <span class="editorial-card__kicker">
                <Icon name="book" size={16} /> Guía
              </span>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
            </a>
          ))
        }
        {
          helmet && (
            <a class="editorial-card" href={`${paths.accessories}${helmet.id}/`}>
              <span class="editorial-card__kicker">
                <Icon name="helmet" size={16} /> Equipamiento
              </span>
              <h3>{helmet.data.title}</h3>
              <p>{helmet.data.description}</p>
            </a>
          )
        }
      </div>
    </section>

    <section class="section">
      <p class="muted">
        MotoGuía reúne fichas técnicas, precios de referencia con fecha y datos de patentamientos de fuentes públicas para que compares
        motos en Argentina con información clara. <a href={paths.methodology}>Cómo trabajamos</a>.
      </p>
    </section>
  </div>
</BaseLayout>
