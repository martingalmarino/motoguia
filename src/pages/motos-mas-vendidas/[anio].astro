---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/editorial/PageHeader.astro';
import SourceList from '../../components/editorial/SourceList.astro';
import RankingTable, { type RankingTableRow } from '../../components/catalog/RankingTable.astro';
import Icon from '../../components/ui/Icon.astro';
import { paths, rankingYearPath } from '../../config/site';
import {
  getBrand,
  getLatestMonthlyRanking,
  getLatestSummaryRanking,
  getPublishedMotorcycles,
  getRankingYears,
  motorcycleUrl,
} from '../../lib/content/catalog';
import { reportModelParts } from '../../lib/content/present';
import { periodLabel } from '../../lib/content/ranking-period';
import { formatDate, formatInteger } from '../../lib/format';
import { breadcrumbLd, itemListLd } from '../../lib/seo/jsonld';

export async function getStaticPaths() {
  const years = await getRankingYears();
  return years.map((year) => ({ params: { anio: String(year) }, props: { year } }));
}

const { year } = Astro.props as { year: number };
const summary = await getLatestSummaryRanking(year);
const month = await getLatestMonthlyRanking(year);
if (!summary) throw new Error(`Missing summary ranking for ${year}`);

const motos = await getPublishedMotorcycles();
const byId = new Map(motos.map((entry) => [entry.data.id, entry]));

type ReportRow = { rank: number; units: number; reportModelName: string; modelIds: string[]; comparableChange?: number | null };

const entryFor = (row: { modelIds: string[] }) => row.modelIds.map((id) => byId.get(id)).find(Boolean);

function tableRow(row: ReportRow, withReportName: boolean): RankingTableRow {
  const entry = entryFor(row);
  const parts = reportModelParts(row.reportModelName);
  return {
    rank: row.rank,
    units: row.units,
    brand: entry ? (getBrand(entry.data.brandId)?.name ?? parts.brand) : parts.brand,
    model: entry ? entry.data.name : parts.model,
    href: entry ? motorcycleUrl(entry) : null,
    note: entry ? (withReportName ? `En el informe: ${row.reportModelName}` : null) : 'Sin ficha en MotoGuía',
    change: row.comparableChange ?? null,
  };
}

const path = rankingYearPath(year);
const summaryLabel = periodLabel(summary.data);
const monthLabel = month ? periodLabel(month.data) : null;
const isAnnual = summary.data.periodType === 'annual';
const summaryHeading = isAnnual ? `Total ${year}` : `Acumulado ${summaryLabel}`;
const showMonth = month && month.data.periodEnd.valueOf() === summary.data.periodEnd.valueOf() && summary.data.periodStart.valueOf() !== month.data.periodStart.valueOf();
const comparisonPeriod = month?.data.rows.find((row) => row.comparisonPeriod)?.comparisonPeriod ?? null;
const topRows = summary.data.rows.slice(0, 10);
const moreRows = summary.data.rows.slice(10);
const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.ranking, label: 'Más vendidas' },
  { href: path, label: String(year) },
];
const sourceIds = [...new Set([...summary.data.sourceIds, ...(showMonth && month ? month.data.sourceIds : [])])];
const summaryMax = Math.max(...summary.data.rows.map((row) => row.units));
const description = showMonth
  ? `Ranking acumulado ${summaryLabel} de patentamientos de motos ACARA/SIOMAA, con el mes de ${monthLabel} aparte.`
  : `Ranking ${summaryLabel} de patentamientos de motos en Argentina según ACARA/SIOMAA.`;
const lede = [
  `Ranking de patentamientos acumulados del ${formatDate(summary.data.periodStart)} al ${formatDate(summary.data.periodEnd)}`,
  summary.data.totalUnits ? `: ${formatInteger(summary.data.totalUnits)} motos en todo el país.` : '.',
  ` El informe de ACARA/SIOMAA tiene fecha ${formatDate(summary.data.reportPublishedAt)}.`,
].join('');
---

<BaseLayout
  title={`Motos más vendidas en Argentina ${year}`}
  description={description}
  path={path}
  modifiedTime={summary.data.verifiedAt}
  jsonLd={[
    breadcrumbLd(crumbs.map((item) => ({ name: item.label, path: item.href }))),
    itemListLd(
      `Patentamientos de motos en Argentina, ${summaryLabel}`,
      summary.data.rows.map((row) => {
        const entry = entryFor(row);
        return { name: row.reportModelName, path: entry ? motorcycleUrl(entry) : undefined };
      }),
    ),
  ]}
>
  <div class="wrap">
    <PageHeader
      crumbs={crumbs}
      eyebrow="Patentamientos ACARA/SIOMAA"
      title={`Motos más vendidas en Argentina en ${year}`}
      lede={lede}
    />

    <section class="section" aria-labelledby="acumulado-titulo">
      <div class="section-heading">
        <div>
          <h2 id="acumulado-titulo">{summaryHeading}</h2>
          <p>Los 10 modelos con más patentamientos {isAnnual ? 'del año' : 'en lo que va del año'}.</p>
        </div>
      </div>
      <RankingTable rows={topRows.map((row) => tableRow(row, true))} maxUnits={summaryMax} labelledBy="acumulado-titulo" />
      {
        moreRows.length > 0 && (
          <details class="more-rows">
            <summary class="toggle-more">
              Ver puestos 11 a {summary.data.rows.length} <Icon name="chevron" size={18} />
            </summary>
            <RankingTable rows={moreRows.map((row) => tableRow(row, false))} maxUnits={summaryMax} label="Puestos 11 en adelante" />
          </details>
        )
      }
    </section>

    {
      showMonth && month && (
        <section class="section" aria-labelledby="mes-titulo">
          <div class="section-heading">
            <div>
              <h2 id="mes-titulo">Solo {monthLabel}</h2>
              <p>
                {month.data.totalUnits ? `${formatInteger(month.data.totalUnits)} motos patentadas en el mes.` : 'Patentamientos del mes.'}
                {comparisonPeriod && ` La variación compara cada modelo con ${comparisonPeriod}.`}
              </p>
            </div>
          </div>
          <RankingTable
            rows={month.data.rows.map((row) => tableRow(row, false))}
            maxUnits={Math.max(...month.data.rows.map((row) => row.units))}
            labelledBy="mes-titulo"
            changeLabel={comparisonPeriod ? `Vs. ${comparisonPeriod.replace(/\s\d{4}$/, '')}` : null}
          />
        </section>
      )
    }

    <section class="section" aria-labelledby="metodo-titulo">
      <div class="notice">
        <h2 id="metodo-titulo">Cómo leer este ranking</h2>
        <p>
          Los números son patentamientos, no ventas de concesionario. ACARA separa algunas versiones en filas distintas (por ejemplo, Wave 110S y Wave 110S CD), y acá se respetan tal como aparecen en el informe. Para el ranking mensual no se usa el boletín de CADECOM, que agrupa versiones y toma otro universo de datos.
        </p>
        <p><a href={paths.methodology}>Ver la metodología de MotoGuía</a></p>
      </div>
      <SourceList ids={sourceIds} />
    </section>
  </div>
</BaseLayout>
