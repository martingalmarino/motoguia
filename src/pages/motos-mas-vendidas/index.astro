---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/editorial/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { paths, rankingYearPath } from '../../config/site';
import { getLatestMonthlyRanking, getLatestSummaryRanking, getRankingYears } from '../../lib/content/catalog';
import { periodLabel, periodPhrase } from '../../lib/content/ranking-period';
import { formatDate } from '../../lib/format';

const years = await getRankingYears();
const cards = (
  await Promise.all(
    years.map(async (year) => ({
      year,
      summary: await getLatestSummaryRanking(year),
      month: await getLatestMonthlyRanking(year),
    })),
  )
).filter((card) => card.summary);
const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.ranking, label: 'Más vendidas' },
];
---

<BaseLayout
  title="Motos más vendidas en Argentina"
  description="Rankings de patentamientos de motos en Argentina según ACARA/SIOMAA, por año y por mes."
  path={paths.ranking}
>
  <div class="wrap">
    <PageHeader
      crumbs={crumbs}
      eyebrow="Rankings"
      title="Motos más vendidas en Argentina"
      lede="Los rankings de MotoGuía se arman con los patentamientos que informa ACARA/SIOMAA. Cada año tiene su propia página, con el acumulado y el último mes publicado."
    />

    <section class="section" aria-labelledby="rankings-titulo">
      <h2 id="rankings-titulo" class="visually-hidden">Rankings disponibles</h2>
      <div class="editorial-cards">
        {
          cards.map(({ year, summary, month }) => (
            <a class="editorial-card" href={rankingYearPath(year)}>
              <span class="editorial-card__kicker">
                <Icon name="tag" size={16} /> Ranking {year}
              </span>
              <h3>Motos más patentadas en {year}</h3>
              <p>
                {[
                  summary!.data.periodType === 'annual' ? `Total del año ${year}` : `Acumulado ${periodPhrase(summary!.data)}`,
                  month && month.data.periodEnd.valueOf() === summary!.data.periodEnd.valueOf()
                    ? ` y el mes de ${periodLabel(month.data)} por separado`
                    : '',
                  ', con las fichas de cada modelo cuando están en MotoGuía.',
                ].join('')}
              </p>
              <span class="editorial-card__meta">Datos al {formatDate(summary!.data.periodEnd)}</span>
            </a>
          ))
        }
      </div>
      <p class="muted">Los rankings de años anteriores se suman en su propia página a medida que se verifican los informes.</p>
    </section>
  </div>
</BaseLayout>
