---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/editorial/PageHeader.astro';
import SourceList from '../../components/editorial/SourceList.astro';
import { paths } from '../../config/site';
import { getPublishedMotorcycles, getRanking, motorcycleUrl } from '../../lib/content/catalog';
import { displayName, reportModelLabel } from '../../lib/content/present';
import { formatDate, formatInteger } from '../../lib/format';
import { itemListLd } from '../../lib/seo/jsonld';

const ytd = await getRanking('2026-ytd');
const month = await getRanking('2026-08');
const motos = await getPublishedMotorcycles();
const byId = new Map(motos.map((entry) => [entry.data.id, entry]));
if (!ytd) throw new Error('Missing YTD ranking');

function rowInfo(row: { reportModelName: string; modelIds: string[] }) {
  const entry = row.modelIds.map((id) => byId.get(id)).find(Boolean);
  return {
    href: entry ? motorcycleUrl(entry) : null,
    name: entry ? displayName(entry) : reportModelLabel(row.reportModelName),
    reportName: row.reportModelName,
  };
}

const topRows = ytd.data.rows.slice(0, 10);
const moreRows = ytd.data.rows.slice(10);
const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.ranking, label: 'Más vendidas' },
  { href: paths.ranking2026, label: '2026' },
];
const sourceIds = [...new Set([...ytd.data.sourceIds, ...(month?.data.sourceIds ?? [])])];
const formatChange = (value: number | null) =>
  value === null ? 'Sin dato' : `${value > 0 ? '+' : ''}${formatInteger(value)}`;
---

<BaseLayout
  title="Motos más vendidas en Argentina 2026"
  description="Ranking acumulado enero-agosto 2026 de patentamientos ACARA/SIOMAA, con el mes de agosto aparte."
  path={paths.ranking2026}
  jsonLd={[itemListLd('Patentamientos motos Argentina 2026 YTD', ytd.data.rows.map((row) => ({ name: row.reportModelName, path: rowInfo(row).href ?? undefined })))]}
>
  <div class="wrap">
    <PageHeader
      crumbs={crumbs}
      eyebrow="Patentamientos ACARA/SIOMAA"
      title="Motos más vendidas en Argentina en 2026"
      lede={`Ranking de patentamientos acumulados del ${formatDate(ytd.data.periodStart)} al ${formatDate(ytd.data.periodEnd)}: 586.650 motos en todo el país. El informe de ACARA/SIOMAA tiene fecha ${formatDate(ytd.data.reportPublishedAt)}.`}
    />

    <section class="section" aria-labelledby="acumulado-titulo">
      <div class="section-heading">
        <div>
          <h2 id="acumulado-titulo">Acumulado enero-agosto 2026</h2>
          <p>Los 10 modelos con más patentamientos en lo que va del año.</p>
        </div>
      </div>
      <div class="table-region" role="region" aria-labelledby="acumulado-titulo" tabindex="0">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Puesto</th>
              <th scope="col">Modelo</th>
              <th scope="col" class="num">Patentamientos</th>
            </tr>
          </thead>
          <tbody>
            {topRows.map((row) => {
              const info = rowInfo(row);
              return (
                <tr>
                  <td class="pos">{row.rank}</td>
                  <th scope="row">
                    {info.href ? <a href={info.href}>{info.name}</a> : info.name}
                    <span class="note">{info.href ? `En el informe: ${info.reportName}` : 'Sin ficha en MotoGuía'}</span>
                  </th>
                  <td class="num">{formatInteger(row.units)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {
        moreRows.length > 0 && (
          <details class="more-rows">
            <summary>Ver puestos 11 a {ytd.data.rows.length}</summary>
            <div class="table-region" role="region" aria-label="Puestos 11 en adelante" tabindex="0">
              <table class="data-table">
                <thead>
                  <tr>
                    <th scope="col">Puesto</th>
                    <th scope="col">Modelo</th>
                    <th scope="col" class="num">Patentamientos</th>
                  </tr>
                </thead>
                <tbody>
                  {moreRows.map((row) => {
                    const info = rowInfo(row);
                    return (
                      <tr>
                        <td class="pos">{row.rank}</td>
                        <th scope="row">
                          {info.href ? <a href={info.href}>{info.name}</a> : info.name}
                          {!info.href && <span class="note">Sin ficha en MotoGuía</span>}
                        </th>
                        <td class="num">{formatInteger(row.units)}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </details>
        )
      }
    </section>

    {
      month && (
        <section class="section" aria-labelledby="agosto-titulo">
          <div class="section-heading">
            <div>
              <h2 id="agosto-titulo">Solo agosto 2026</h2>
              <p>73.566 motos patentadas en el mes. La variación compara cada modelo con julio de 2026.</p>
            </div>
          </div>
          <div class="table-region" role="region" aria-labelledby="agosto-titulo" tabindex="0">
            <table class="data-table">
              <thead>
                <tr>
                  <th scope="col">Puesto</th>
                  <th scope="col">Modelo</th>
                  <th scope="col" class="num">Patentamientos</th>
                  <th scope="col" class="num">Vs. julio</th>
                </tr>
              </thead>
              <tbody>
                {month.data.rows.map((row) => {
                  const info = rowInfo(row);
                  return (
                    <tr>
                      <td class="pos">{row.rank}</td>
                      <th scope="row">{info.href ? <a href={info.href}>{info.name}</a> : info.name}</th>
                      <td class="num">{formatInteger(row.units)}</td>
                      <td class="num">{formatChange(row.comparableChange)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby="metodo-titulo">
      <div class="notice">
        <h2 id="metodo-titulo">Cómo leer este ranking</h2>
        <p>
          Los números son patentamientos, no ventas de concesionario. ACARA separa algunas versiones en filas distintas (por ejemplo, Wave 110S y Wave 110S CD), y acá se respetan tal como aparecen en el informe. Para agosto no se usa el boletín de CADECOM, que agrupa versiones y toma otro universo de datos.
        </p>
        <p><a href={paths.methodology}>Ver la metodología de MotoGuía</a></p>
      </div>
      <SourceList ids={sourceIds} />
    </section>
  </div>
</BaseLayout>
