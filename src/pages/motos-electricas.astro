---
import BaseLayout from '../layouts/BaseLayout.astro';
import MotorcycleCard from '../components/catalog/MotorcycleCard.astro';
import PageHeader from '../components/editorial/PageHeader.astro';
import Icon from '../components/ui/Icon.astro';
import { paths } from '../config/site';
import { getLatestSummaryRanking, getPublishedMotorcycles } from '../lib/content/catalog';
import { periodPhrase } from '../lib/content/ranking-period';
import { formatInteger } from '../lib/format';
import { modelListingLd } from '../lib/seo/jsonld';

const motos = (await getPublishedMotorcycles()).filter((entry) => entry.data.engineType === 'electric');
const summary = await getLatestSummaryRanking();
const sunra = summary?.data.brandTotals.find((item) => item.brand.toUpperCase() === 'SUNRA');
const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.catalog, label: 'Motos' },
  { href: paths.electric, label: 'Motos eléctricas' },
];
const description =
  'Motos eléctricas en Argentina con potencia, autonomía, batería, tiempo de carga y licencia, según la ficha de cada marca.';
---

<BaseLayout
  title="Motos eléctricas en Argentina"
  description={description}
  path={paths.electric}
  jsonLd={modelListingLd({ name: 'Motos eléctricas en Argentina', description, path: paths.electric, crumbs, models: motos })}
>
  <div class="wrap">
    <PageHeader
      crumbs={crumbs}
      eyebrow="Motos"
      title="Motos eléctricas en Argentina"
      lede="SIAM, Motomel y SUNRA tienen motos eléctricas en catálogo. Compará potencia, autonomía, batería y tiempo de carga con los datos que publica cada marca."
    />

    <section class="section" aria-labelledby="electricas-modelos">
      <div class="section-heading">
        <div>
          <h2 id="electricas-modelos">Modelos eléctricos</h2>
          <p>{motos.length} modelos con ficha en MotoGuía.</p>
        </div>
        <a class="link-arrow" href={`${paths.catalog}#motor=electric`}>Ver en el catálogo <Icon name="arrow" size={16} /></a>
      </div>
      <div class="card-grid card-grid--3">
        {motos.map((entry) => <MotorcycleCard entry={entry} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="electricas-leer">
      <div class="prose">
        <h2 id="electricas-leer">Cómo leer la ficha de una moto eléctrica</h2>
        <ul>
          <li>Potencia nominal y potencia pico, cuando la marca las informa por separado.</li>
          <li>Autonomía con sus condiciones: velocidad, peso y clima. 150 km a 40 km/h no equivalen a 150 km a 80 km/h.</li>
          <li>Capacidad útil de la batería y no solo los Ah y V de la etiqueta.</li>
          <li>Tiempo de carga y si la batería se puede extraer.</li>
          <li>Costo de reemplazo de la batería: si la marca no lo publica, conviene pedirlo por escrito.</li>
        </ul>
        {
          sunra && summary && (
            <>
              <h2>Patentamientos</h2>
              <p>
                ACARA registró {formatInteger(sunra.units)} patentamientos de la marca SUNRA {periodPhrase(summary.data)}. El informe no separa esa cifra por modelo, así que no la usamos para armar un ranking de motos eléctricas.
              </p>
            </>
          )
        }
        <h2>Licencia</h2>
        <p>
          No todos los vehículos eléctricos de dos ruedas piden la misma licencia. Revisá las clases en la <a href={`${paths.guides}licencia-moto-argentina/`}>guía de licencias de la ANSV</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
