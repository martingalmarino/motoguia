---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchForm from '../components/search/SearchForm.astro';
import Icon from '../components/ui/Icon.astro';
import { paths } from '../config/site';
---

<BaseLayout title="Página no encontrada" description="Esa ruta no existe en MotoGuía AR." path="/404.html" noindex={true}>
  <div class="wrap">
    <header class="page-intro not-found">
      <p class="eyebrow">Error 404</p>
      <h1>No encontramos esa página</h1>
      <p class="lede">Puede que la dirección haya cambiado. Buscá una moto o volvé al inicio.</p>
      <SearchForm id="busqueda-404" variant="dialog" />
      <p class="not-found__links">
        <a class="link-arrow" href={paths.home}>Ir al inicio <Icon name="arrow" size={16} /></a>
        <a class="link-arrow" href={paths.catalog}>Ver todas las motos <Icon name="arrow" size={16} /></a>
      </p>
    </header>
  </div>
</BaseLayout>
