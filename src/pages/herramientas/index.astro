---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/editorial/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { paths } from '../../config/site';

const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.tools, label: 'Herramientas' },
];
const tools = [
  {
    href: paths.comparator,
    icon: 'compare',
    title: 'Compará motos',
    text: 'Compará las características de hasta 3 motos.',
    cta: 'Ir al comparador',
  },
  {
    href: paths.fuel,
    icon: 'fuel',
    title: 'Calculá tu gasto en combustible',
    text: 'Estimá cuánto gastás según tus kilómetros y el precio por litro.',
    cta: 'Calcular combustible',
  },
  {
    href: paths.monthlyCost,
    icon: 'wallet',
    title: 'Estimá el costo mensual',
    text: 'Sumá combustible, seguro, patente y mantenimiento.',
    cta: 'Calcular costo mensual',
  },
] as const;
---

<BaseLayout
  title="Herramientas para elegir moto"
  description="Comparador de motos y calculadoras de combustible y costo mensual para motos en Argentina."
  path={paths.tools}
>
  <div class="wrap">
    <PageHeader
      crumbs={crumbs}
      eyebrow="Herramientas"
      title="Herramientas para decidir"
      lede="Compará modelos y hacé tus cuentas antes de elegir. Las calculadoras usan los valores que cargás vos."
    />

    <section class="section" aria-labelledby="herramientas-lista">
      <h2 id="herramientas-lista" class="visually-hidden">Herramientas disponibles</h2>
      <div class="tool-tiles">
        {
          tools.map((tool) => (
            <a class="tool-tile" href={tool.href}>
              <span class="tool-tile__icon">
                <Icon name={tool.icon} size={24} />
              </span>
              <h3>{tool.title}</h3>
              <p>{tool.text}</p>
              <span class="tool-tile__cta">
                {tool.cta} <Icon name="arrow" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
