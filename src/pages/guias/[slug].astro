---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/editorial/Breadcrumbs.astro';
import SourceList from '../../components/editorial/SourceList.astro';
import ArticleToc from '../../components/editorial/ArticleToc.astro';
import MotorcycleCard from '../../components/catalog/MotorcycleCard.astro';
import AdSlot from '../../components/monetization/AdSlot.astro';
import { paths } from '../../config/site';
import { getPublishedGuides, getPublishedMotorcycles, render } from '../../lib/content/catalog';
import { formatDate, isoDate } from '../../lib/format';
import { articleLd, breadcrumbLd } from '../../lib/seo/jsonld';

export async function getStaticPaths() {
  const guides = await getPublishedGuides();
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const path = `${paths.guides}${entry.id}/`;
const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.guides, label: 'Guías' },
  { href: path, label: entry.data.title },
];
const motos = await getPublishedMotorcycles();
const related = entry.data.relatedModelIds
  .map((id) => motos.find((moto) => moto.data.id === id))
  .filter((moto): moto is (typeof motos)[number] => Boolean(moto))
  .slice(0, 3);
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  path={path}
  ogType="article"
  modifiedTime={entry.data.reviewedAt}
  publishedTime={entry.data.publishedAt}
  jsonLd={[
    breadcrumbLd(crumbs.map((item) => ({ name: item.label, path: item.href }))),
    articleLd({
      headline: entry.data.title,
      description: entry.data.description,
      path,
      datePublished: isoDate(entry.data.publishedAt),
      dateModified: isoDate(entry.data.reviewedAt),
    }),
  ]}
>
  <div class="wrap">
    <div class="article-layout">
      <article class="article">
        <header class="article-header">
          <Breadcrumbs items={crumbs} />
          <p class="eyebrow">Guía</p>
          <h1>{entry.data.title}</h1>
          <p class="lede">{entry.data.description}</p>
          <p class="article-meta">
            {entry.data.author} · Actualizada el <time datetime={isoDate(entry.data.reviewedAt)}>{formatDate(entry.data.reviewedAt)}</time>
          </p>
        </header>
        <AdSlot slot="article" />
        <div class="prose">
          <Content />
        </div>
        <SourceList ids={entry.data.sourceIds} />
      </article>
      <ArticleToc headings={headings} title="En esta guía" />
    </div>

    {
      related.length > 0 && (
        <section class="section" aria-labelledby="guia-motos">
          <div class="section-heading">
            <div>
              <h2 id="guia-motos">Motos mencionadas en esta guía</h2>
            </div>
          </div>
          <div class="card-grid card-grid--3">
            {related.map((moto) => (
              <MotorcycleCard entry={moto} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
