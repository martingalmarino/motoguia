---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/editorial/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { paths } from '../../config/site';
import { getPublishedGuides } from '../../lib/content/catalog';
import { formatDate } from '../../lib/format';

const guides = await getPublishedGuides();
const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.guides, label: 'Guías' },
];
---

<BaseLayout
  title="Guías para comprar y mantener una moto"
  description="Guías prácticas para elegir tu primera moto, comparar 110, 125 y 150, sacar la licencia, comprar usada, revisar la garantía y calcular gastos."
  path={paths.guides}
>
  <div class="wrap">
    <PageHeader
      crumbs={crumbs}
      eyebrow="Guías"
      title="Guías para elegir, comprar y mantener tu moto"
      lede="Qué moto elegir, qué licencia sacar, cómo revisar una usada, qué cubre la garantía y cuánto cuesta mantenerla: seis guías prácticas para decidir con datos verificables."
    />

    <section class="section" aria-labelledby="guias-lista">
      <h2 id="guias-lista" class="visually-hidden">Todas las guías</h2>
      <div class="editorial-cards">
        {
          guides.map((guide) => (
            <a class="editorial-card" href={`${paths.guides}${guide.id}/`}>
              <span class="editorial-card__kicker">
                <Icon name="book" size={16} /> Guía
              </span>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
              <span class="editorial-card__meta">Actualizada el {formatDate(guide.data.reviewedAt)}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="guias-equipamiento">
      <div class="section-heading">
        <div>
          <h2 id="guias-equipamiento">Equipamiento y accesorios</h2>
          <p>Casco, guantes y trabas: qué mirar antes de comprar.</p>
        </div>
        <a class="link-arrow" href={paths.accessories}>Ver guías de accesorios <Icon name="arrow" size={16} /></a>
      </div>
    </section>
  </div>
</BaseLayout>
