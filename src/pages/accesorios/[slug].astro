---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/editorial/Breadcrumbs.astro';
import SourceList from '../../components/editorial/SourceList.astro';
import ArticleToc from '../../components/editorial/ArticleToc.astro';
import { paths } from '../../config/site';
import { getPublishedAccessoryGuides, render } from '../../lib/content/catalog';
import { formatDate, isoDate } from '../../lib/format';
import { articleLd, breadcrumbLd } from '../../lib/seo/jsonld';

export async function getStaticPaths() {
  const items = await getPublishedAccessoryGuides();
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const path = `${paths.accessories}${entry.id}/`;
const crumbs = [
  { href: paths.home, label: 'Inicio' },
  { href: paths.accessories, label: 'Accesorios' },
  { href: path, label: entry.data.title },
];
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  path={path}
  ogType="article"
  jsonLd={[
    breadcrumbLd(crumbs.map((item) => ({ name: item.label, path: item.href }))),
    articleLd({
      headline: entry.data.title,
      description: entry.data.description,
      path,
      datePublished: isoDate(entry.data.publishedAt),
      dateModified: isoDate(entry.data.reviewedAt),
    }),
  ]}
>
  <div class="wrap">
    <div class="article-layout">
      <article class="article">
        <header class="article-header">
          <Breadcrumbs items={crumbs} />
          <p class="eyebrow">Equipamiento</p>
          <h1>{entry.data.title}</h1>
          <p class="lede">{entry.data.description}</p>
          <p class="article-meta">
            {entry.data.author} · Actualizada el <time datetime={isoDate(entry.data.reviewedAt)}>{formatDate(entry.data.reviewedAt)}</time>
          </p>
        </header>
        <p class="notice">
          Algunos enlaces de compra pueden ser de afiliado: si comprás a través de ellos, podemos recibir una comisión. <a href={paths.affiliates}>Más información</a>.
        </p>
        <div class="prose">
          <Content />
        </div>
        <SourceList ids={entry.data.sourceIds} />
      </article>
      <ArticleToc headings={headings} title="En esta guía" />
    </div>
  </div>
</BaseLayout>
