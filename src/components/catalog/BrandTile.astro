---
import { paths } from '../../config/site';
import type { Brand } from '../../lib/content/catalog';
import BrandMark from './BrandMark.astro';

interface Props {
  brand: Brand;
  count: number;
  size?: 'md' | 'lg';
}

const { brand, count, size = 'md' } = Astro.props;
---

<a class="brand-tile" href={`${paths.brands}${brand.slug}/`}>
  <span class="brand-tile__mark">
    <BrandMark brand={brand} size={size} />
  </span>
  <span class="brand-tile__count">{count} {count === 1 ? 'modelo' : 'modelos'}</span>
</a>
