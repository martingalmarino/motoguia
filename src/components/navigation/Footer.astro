---
import Logo from './Logo.astro';
import { author, footerGroups, paths } from '../../config/site';
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <a href={paths.home} aria-label="MotoGuía AR, inicio"><Logo /></a>
      <p>Modelos, fichas técnicas, comparaciones y calculadoras para elegir tu próxima moto en Argentina.</p>
    </div>
    <div class="site-footer__groups">
      {
        footerGroups.map((group) => (
          <section>
            <h2>{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  {link.href.startsWith('http') ? (
                    <a href={link.href} target="_blank" rel="noopener">
                      {link.label}
                    </a>
                  ) : (
                    <a href={link.href}>{link.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
  <div class="wrap site-footer__note">
    <p>MotoGuía AR es un sitio de información: no vende motos. Los precios son referencias con fecha y pueden cambiar.</p>
    <p class="site-footer__credit">
      Desarrollado por <a href={`mailto:${author.email}`}>{author.name}</a>
    </p>
  </div>
</footer>
