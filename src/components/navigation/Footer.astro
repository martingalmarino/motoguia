---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import { author, footerGroups, footerLegalLinks, paths } from '../../config/site';
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <a href={paths.home} aria-label="MotoGuía AR, inicio"><Logo /></a>
      <p>Modelos, fichas técnicas, comparaciones y calculadoras para elegir tu próxima moto en Argentina.</p>
    </div>
    <div class="site-footer__groups">
      {
        footerGroups.map((group) => (
          <details class="footer-group" open data-footer-group>
            <summary>
              <h2>{group.title}</h2>
              <Icon name="chevron" size={20} />
            </summary>
            <ul>
              {group.links.map((link) => (
                <li>
                  {link.href.startsWith('http') ? (
                    <a href={link.href} target="_blank" rel="noopener">
                      {link.label}
                    </a>
                  ) : (
                    <a href={link.href}>{link.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
  <div class="wrap site-footer__bottom">
    <nav class="site-footer__legal" aria-label="Legales">
      <ul>
        {
          footerLegalLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="site-footer__note">MotoGuía AR es un sitio de información: no vende motos. Los precios son referencias con fecha y pueden cambiar.</p>
    <p class="site-footer__credit">
      Desarrollado por <a href={`mailto:${author.email}`}>{author.name}</a>
    </p>
  </div>
</footer>

<script>
  const groups = document.querySelectorAll<HTMLDetailsElement>('[data-footer-group]');
  const compact = window.matchMedia('(max-width: 767px)');

  const sync = () => {
    groups.forEach((group) => {
      group.open = !compact.matches;
      group.querySelector('summary')?.setAttribute('tabindex', compact.matches ? '0' : '-1');
    });
  };

  groups.forEach((group) => {
    group.querySelector('summary')?.addEventListener('click', (event) => {
      if (!compact.matches) event.preventDefault();
    });
  });

  sync();
  compact.addEventListener('change', sync);
</script>
