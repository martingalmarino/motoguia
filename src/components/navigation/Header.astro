---
import Icon from '../ui/Icon.astro';
import Logo from './Logo.astro';
import SearchForm from '../search/SearchForm.astro';
import { navItems, paths } from '../../config/site';

const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const categories = navItems.find((item) => item.href === paths.catalog)?.children ?? [];
const isCategoryCurrent = (href: string) =>
  href === paths.catalog ? current === href : current === href || current.startsWith(href);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__logo" href={paths.home} aria-label="MotoGuía AR, inicio">
      <Logo />
    </a>

    <nav class="main-nav" aria-label="Principal">
      <ul class="main-nav__list">
        {
          navItems.map((item, index) =>
            item.children ? (
              <li class="main-nav__item has-sub" data-subnav>
                <a
                  class:list={['main-nav__link', { 'is-current': isCurrent(item.href) }]}
                  href={item.href}
                  aria-current={current === item.href ? 'page' : isCurrent(item.href) ? 'true' : undefined}
                >
                  {item.label}
                </a>
                <button
                  class="main-nav__toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`subnav-${index}`}
                  data-subnav-toggle
                >
                  <span class="visually-hidden">Más opciones de {item.label}</span>
                  <Icon name="chevron" size={16} />
                </button>
                <ul class:list={['main-nav__sub', { 'main-nav__sub--cats': item.children.length > 4 }]} id={`subnav-${index}`}>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={current === child.href ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="main-nav__item">
                <a
                  class:list={['main-nav__link', { 'is-current': isCurrent(item.href) }]}
                  href={item.href}
                  aria-current={current === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button class="icon-btn" type="button" data-search-open aria-haspopup="dialog" aria-controls="dialogo-busqueda">
        <Icon name="search" />
        <span class="visually-hidden">Buscar motos</span>
      </button>
      <a class="header-compare" href={paths.comparator} data-compare-link hidden>
        <Icon name="compare" />
        <span class="header-compare__label">Comparador</span>
        <span class="header-compare__count" data-compare-count aria-label="modelos elegidos">0</span>
      </a>
      <button
        class="icon-btn site-header__menu"
        type="button"
        data-drawer-open
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-controls="menu-movil"
      >
        <Icon name="menu" />
        <span class="visually-hidden">Abrir menú</span>
      </button>
    </div>
  </div>
  {
    categories.length > 0 && (
      <nav class="cat-nav" aria-label="Categorías de motos">
        <div class="wrap cat-nav__clip">
          <ul class="cat-nav__list">
            {categories.map((item) => (
              <li>
                <a
                  class:list={['cat-nav__link', { 'is-current': isCategoryCurrent(item.href) }]}
                  href={item.href}
                  aria-current={isCategoryCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )
  }
</header>

<dialog class="search-dialog" id="dialogo-busqueda" aria-labelledby="dialogo-busqueda-titulo" data-search-dialog>
  <div class="search-dialog__panel">
    <div class="search-dialog__head">
      <h2 id="dialogo-busqueda-titulo" class="search-dialog__title">Buscar motos</h2>
      <button class="icon-btn icon-btn--light" type="button" data-dialog-close>
        <Icon name="close" />
        <span class="visually-hidden">Cerrar búsqueda</span>
      </button>
    </div>
    <SearchForm id="busqueda-dialogo" variant="dialog" />
    <p class="search-dialog__more">
      ¿Buscás una guía o una comparativa? <a href={paths.search}>Buscar en todo el sitio</a>
    </p>
  </div>
</dialog>

<dialog class="nav-drawer" id="menu-movil" aria-label="Menú" data-nav-drawer>
  <div class="nav-drawer__panel">
    <div class="nav-drawer__head">
      <Logo />
      <button class="icon-btn" type="button" data-dialog-close>
        <Icon name="close" />
        <span class="visually-hidden">Cerrar menú</span>
      </button>
    </div>
    <nav aria-label="Menú móvil">
      {
        navItems.map((item) => (
          <div class="nav-drawer__group">
            <a class="nav-drawer__link" href={item.href} aria-current={current === item.href ? 'page' : isCurrent(item.href) ? 'true' : undefined}>
              {item.label}
            </a>
            {item.children && (
              <ul class:list={['nav-drawer__sub', { 'nav-drawer__sub--cats': item.children.length > 4 }]}>
                {item.children
                  .filter((child) => child.href !== item.href)
                  .map((child) => (
                    <li>
                      <a href={child.href} aria-current={current === child.href ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
              </ul>
            )}
          </div>
        ))
      }
      <div class="nav-drawer__group">
        <a class="nav-drawer__link" href={paths.comparator}>
          Comparador <span class="nav-drawer__count" data-compare-count-drawer hidden></span>
        </a>
      </div>
    </nav>
  </div>
</dialog>

<script>
  import '../../scripts/site-header';
</script>
