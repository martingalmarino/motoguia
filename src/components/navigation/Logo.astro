---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 64 64" width="34" height="34" aria-hidden="true" focusable="false">
    <rect class="logo__mark-bg" width="64" height="64" rx="14" />
    <path class="logo__mark-m" d="M16 44V20l16 15 16-15v24" fill="none" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
    <rect class="logo__mark-bar" x="16" y="49" width="32" height="4" rx="2" />
  </svg>
  <span class="logo__word">MotoGuía</span>
  <span class="logo__geo">AR</span>
</span>
