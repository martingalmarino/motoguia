---
import { resolveSources } from '../../lib/content/catalog';
import { formatDate } from '../../lib/format';

interface Props {
  ids: string[];
  title?: string | null;
}

const { ids, title = 'Fuentes' } = Astro.props;
const sources = resolveSources(ids);
---

{
  sources.length > 0 && (
    <section class="source-notes">
      {title && <h2>{title}</h2>}
      <ul>
        {sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener">
              {source.title}
            </a>
            <span class="muted">
              {' '}
              · {source.publisher}
              {source.publishedAt ? `, publicado el ${formatDate(source.publishedAt)}` : ''}. Consultado el {formatDate(source.accessedAt)}.
            </span>
          </li>
        ))}
      </ul>
    </section>
  )
}
