---
import { resolveSources } from '../../lib/content/catalog';
import { formatDate } from '../../lib/format';

interface Props {
  ids: string[];
}

const { ids } = Astro.props;
const sources = resolveSources(ids);
---

{
  sources.length > 0 && (
    <section>
      <h2>Fuentes</h2>
      <ul>
        {sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener">{source.title}</a>
            <span class="muted">
              {' '}
              — {source.publisher}
              {source.publishedAt ? `, publicado ${formatDate(source.publishedAt)}` : ''}
              , acceso {formatDate(source.accessedAt)}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )
}
