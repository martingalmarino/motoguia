---
interface Props {
  product: {
    name: string;
    brand?: string;
    model?: string;
    type?: string;
    size?: string;
    certification?: string;
    price?: {
      amount: number;
      date: string;
    };
    reason: string;
    features: string[];
    limitations: string[];
    url: string;
  };
}

const { product } = Astro.props;
---

<div class="affiliate-product">
  <div class="affiliate-product__content">
    <h3 class="affiliate-product__title">{product.name}</h3>
    
    {product.reason && (
      <p class="affiliate-product__reason">{product.reason}</p>
    )}

    <div class="affiliate-product__details">
      {product.brand && (
        <div class="affiliate-product__detail">
          <strong>Marca:</strong> {product.brand}
        </div>
      )}
      {product.model && (
        <div class="affiliate-product__detail">
          <strong>Modelo:</strong> {product.model}
        </div>
      )}
      {product.type && (
        <div class="affiliate-product__detail">
          <strong>Tipo:</strong> {product.type}
        </div>
      )}
      {product.size && (
        <div class="affiliate-product__detail">
          <strong>Talle:</strong> {product.size}
        </div>
      )}
      {product.certification && (
        <div class="affiliate-product__detail">
          <strong>Certificación declarada:</strong> {product.certification}
        </div>
      )}
      {product.price && (
        <div class="affiliate-product__price">
          ${product.price.amount.toLocaleString('es-AR')}
          <span class="affiliate-product__price-note">
            (observado el {product.price.date}, puede variar)
          </span>
        </div>
      )}
    </div>

    {product.features.length > 0 && (
      <div class="affiliate-product__section">
        <strong>Características destacadas:</strong>
        <ul>
          {product.features.map((feature) => <li>{feature}</li>)}
        </ul>
      </div>
    )}

    {product.limitations.length > 0 && (
      <div class="affiliate-product__section">
        <strong>Limitaciones:</strong>
        <ul>
          {product.limitations.map((limitation) => <li>{limitation}</li>)}
        </ul>
      </div>
    )}

    <a
      href={product.url}
      class="affiliate-product__cta"
      rel="sponsored nofollow noopener"
      target="_blank"
    >
      Consultar el producto en Mercado Libre
      <svg class="affiliate-product__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/>
      </svg>
    </a>
  </div>
</div>

<style>
  .affiliate-product {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .affiliate-product__title {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .affiliate-product__reason {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    background: var(--bg-primary);
    border-left: 3px solid var(--primary);
    font-style: italic;
    color: var(--text-secondary);
  }

  .affiliate-product__details {
    margin-bottom: 1.5rem;
    display: grid;
    gap: 0.5rem;
  }

  .affiliate-product__detail {
    font-size: 0.95rem;
  }

  .affiliate-product__detail strong {
    color: var(--text-primary);
  }

  .affiliate-product__price {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
  }

  .affiliate-product__price-note {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-secondary);
  }

  .affiliate-product__section {
    margin-bottom: 1.5rem;
  }

  .affiliate-product__section strong {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .affiliate-product__section ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .affiliate-product__section li {
    margin-bottom: 0.25rem;
    color: var(--text-secondary);
  }

  .affiliate-product__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--primary);
    color: white;
    text-decoration: none;
    font-weight: 600;
    border-radius: 0.375rem;
    transition: background 0.2s;
  }

  .affiliate-product__cta:hover {
    background: var(--primary-hover, #1d4ed8);
  }

  .affiliate-product__icon {
    flex-shrink: 0;
  }
</style>
